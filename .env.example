# POSTGRES_PASSWORD=moneta
# POSTGRES_PORT=5432
# FRONTEND_PORT=8080
# TZ=America/Sao_Paulo
# BACKEND_PATH=../moneta-backend
# SCHEDULE_PATH=../moneta-schedule
